# Only needed for `npm run dev` / `npm run preview` OUTSIDE Docker. Inside
# docker-compose, nginx.conf proxies /api/* to the backend container.
# Leave unset in dev too: vite.config.js proxies /api to localhost:8000.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# "true" = run on built-in demo data with no backend at all.
VITE_USE_MOCK=false

# Links on the "Other platforms" card (optional)
# VITE_SETU_URL=http://localhost:5174
# VITE_NAYAN_URL=https://<your-nayan-web-build>
