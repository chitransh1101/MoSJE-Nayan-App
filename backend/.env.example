# Copy this file to .env and fill in real values before running in production.
# Every value here has a safe default in app/core/config.py for local dev,
# so the app runs out of the box with NO .env file at all - .env only
# overrides what you need to change.

# --- App ---
APP_NAME=DoSJE Nigrani API
# ENV=production refuses to start unless JWT_SECRET_KEY is a real secret
# (32+ chars), CORS_ORIGINS lists real origins and DEBUG=false. It also
# turns off /docs and adds HSTS.
ENV=development
DEBUG=true

# --- Database ---
# Local dev / tests: sqlite (default, zero setup)
# Docker / production: postgresql://dosje:dosje_dev@db:5432/dosje
DATABASE_URL=sqlite:///./dosje_nigrani.db

# --- Auth ---
# Generate a real secret for production: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# Access tokens are short-lived; the apps renew them while in use.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Server-side sessions: dropped after this long unused, and never older than this.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Failed sign-ins per email before sign-in pauses for LOCKOUT_MINUTES.
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Shown as the account name in authenticator apps.
MFA_ISSUER=DoSJE Nigrani
# Beneficiary self-sign-up. Off = only an admin creates accounts.
ALLOW_PUBLIC_SIGNUP=false
# Largest request body / upload accepted.
MAX_UPLOAD_MB=60
# true only when the API sits behind your own reverse proxy (reads X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# --- CORS ---
# "*" allows any frontend origin (fine for local dev). Once you have a
# real deployed frontend URL, set this explicitly, comma-separated if
# more than one, e.g.:
# CORS_ORIGINS=https://your-dashboard.onrender.com,http://localhost:5173
CORS_ORIGINS=*

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- Object storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./evidence_store
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=evidence-bucket

# --- Assignment engine ---
FAIRNESS_WINDOW=5
GEOFENCE_RADIUS_METERS=500.0

# --- VC calls ---
VC_PICKUP_WINDOW_SECONDS=120

# --- Yukt assistant (AI keys stay on the server; the apps never see them) ---
# Leave YUKT_LLM_API_KEY empty and Yukt answers from the apps' own local engine.
# YUKT_LLM_PROVIDER=anthropic          # or "openai" for any OpenAI-compatible server
# YUKT_LLM_MODEL=
# YUKT_LLM_API_KEY=
# YUKT_LLM_BASE_URL=https://api.openai.com/v1
# Bhashini (22 Indian languages: translation, speech):
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Demo data ---
# RUN_SEED_ON_START=true seeds the same demo people and institutes the three
# frontends show in demo mode (all passwords: Password123!).
