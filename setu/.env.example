# Copy to .env and edit. All optional.
# Backend (the same one Sentinel uses). Default: /api/v1 (proxied to :8000 by vite.config.js)
VITE_API_BASE_URL=/api/v1
# "true" = built-in demo data, no backend at all
VITE_USE_MOCK=false
# Where the Sentinel / Nayan links should go
VITE_SENTINEL_URL=http://localhost:5173
VITE_NAYAN_URL=
